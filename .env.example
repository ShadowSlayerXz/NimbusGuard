# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://nimbusguard:nimbusguard@localhost:5432/nimbusguard
POSTGRES_USER=nimbusguard
POSTGRES_PASSWORD=nimbusguard
POSTGRES_DB=nimbusguard

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI (PDF analysis) ─────────────────────────────────
# Free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ─── External Signal APIs (all optional) ───────────────
# Cloudflare Radar — BGP hijack feed (free at dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_KEY=your_cloudflare_api_key_here

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
